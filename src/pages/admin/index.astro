                name: "pubDate",
                widget: "datetime",
              },
              {
                label: "Hero Image",
                name: "heroImage",
                widget: "image",
              },
              {
                label: "Body",
                name: "body",
                widget: "markdown",
              },
            ],
          },
        ],
