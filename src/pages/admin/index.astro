        },
        auth: {
          email_claim: "email",
          first_name_claim: "first_name",
          last_name_claim: "last_name",
          avatar_url_claim: "avatar_url",
        },
        load_config_file: false,
        media_folder: "/src/assets",
        collections: [
          {
            name: "posts",
            label: "Posts",
            folder: "/src/content/blog",
            create: true,
